    <div class="quote-banner" style="width:100vw;max-width:100vw;position:relative;left:0;right:0;margin:0 auto;background:#fff;height:100vh;min-height:400px;padding:0;text-align:center;box-shadow:0 2px 24px 0 rgba(26,35,126,0.07);display:flex;flex-direction:column;align-items:center;justify-content:center;">
