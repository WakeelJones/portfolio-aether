          overlay.style.fontSize = '2rem';
          overlay.style.fontFamily = 'Inter, Segoe UI, Arial, sans-serif';
          overlay.innerHTML = '<div style="text-align:center;"><b>This site only works in Google Chrome.</b><br/><br/>Please open this page in Chrome for the best experience.</div>';
          document.body.appendChild(overlay);
          document.body.style.overflow = 'hidden';
