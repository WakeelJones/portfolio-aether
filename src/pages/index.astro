    <script>
      if (typeof window !== 'undefined') {
        const quotes = [
          { text: '"Any sufficiently advanced technology is indistinguishable from magic."', author: '- Arthur C. Clarke' },
          { text: '"Programs must be written for people to read, and only incidentally for machines to execute."', author: '- Harold Abelson' },
          { text: '"The best way to predict the future is to invent it."', author: '- Alan Kay' }
        ];
        let quoteIndex = 0;
        const quoteText = document.getElementById('quote-text');
        const quoteDots = document.getElementById('quote-dots');
        function updateQuote() {
          if (quoteText && quoteDots) {
            quoteText.innerHTML = `${quotes[quoteIndex].text}<br><span>${quotes[quoteIndex].author}</span>`;
            // Update dots
            quoteDots.innerHTML = '';
            quotes.forEach((_, i) => {
              const dot = document.createElement('button');
              dot.className = 'quote-dot' + (i === quoteIndex ? ' active' : '');
              dot.setAttribute('aria-label', `Show quote ${i + 1}`);
              dot.addEventListener('click', () => {
                quoteIndex = i;
                updateQuote();
                stopAutoScroll();
                startAutoScroll();
              });
              quoteDots.appendChild(dot);
            });
          }
        }
        let autoScrollInterval: number | undefined;
        function startAutoScroll() {
          autoScrollInterval = window.setInterval(() => {
            quoteIndex = (quoteIndex + 1) % quotes.length;
            updateQuote();
          }, 5000);
        }
        function stopAutoScroll() {
          if (autoScrollInterval) window.clearInterval(autoScrollInterval);
        }
        const banner = document.querySelector('.quote-banner');
        if (banner && quoteText && quoteDots) {
          banner.addEventListener('mouseenter', stopAutoScroll);
          banner.addEventListener('mouseleave', startAutoScroll);
          updateQuote();
          startAutoScroll();
        }
      }
    </script>
