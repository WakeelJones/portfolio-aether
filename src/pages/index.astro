    <footer class="main-footer" style="width:100vw;background:linear-gradient(90deg,#7f53ac,#647dee,#00bfae,#c6ff00);color:#fff;padding:1.5rem 0 1.2rem 0;position:relative;bottom:0;left:0;z-index:100;text-align:center;font-size:1.08rem;font-weight:600;letter-spacing:0.01em;box-shadow:0 -2px 16px 0 rgba(26,35,126,0.10);margin-top:auto;">
      <div class="footer-content">&copy; <span id="copyright-year"></span> Wakeel Jones. All rights reserved.</div>
    </footer>
    <div class="custom-cursor" id="custom-cursor"></div>
    <script>
      if (typeof window !== 'undefined') {
        console.log('DEBUG: Custom cursor/gradient script running');
        const cursor = document.getElementById('custom-cursor') as HTMLElement | null;
        const gradientSpot = document.querySelector('.hero-gradient-spot') as HTMLElement | null;
        if (cursor) {
          cursor.style.opacity = '1';
          cursor.style.display = 'block';
          cursor.style.background = 'rgba(255,0,0,0.5)'; // DEBUG: Make cursor red for visibility
          console.log('DEBUG: custom-cursor element found and forced visible');
        } else {
          console.warn('DEBUG: custom-cursor element NOT found');
        }
        if (gradientSpot) {
          gradientSpot.style.opacity = '1';
          gradientSpot.style.display = 'block';
          gradientSpot.style.background = 'radial-gradient(circle at center, #00ff00 0%, #fff0 80%)'; // DEBUG: Make spot green
          gradientSpot.style.width = '340px';
          gradientSpot.style.height = '340px';
          gradientSpot.style.zIndex = '10000';
          console.log('DEBUG: hero-gradient-spot element found and forced visible');
        } else {
          console.warn('DEBUG: hero-gradient-spot element NOT found');
        }
        const copyrightYear = document.getElementById('copyright-year');
        if (copyrightYear) copyrightYear.textContent = new Date().getFullYear().toString();
        // Hamburger menu toggle
        const hamburger = document.getElementById('nav-hamburger');
        const dropdown = document.getElementById('nav-dropdown');
        const mainNav = document.querySelector('.main-nav');
        hamburger?.addEventListener('click', () => {
          const expanded = hamburger.getAttribute('aria-expanded') === 'true';
          hamburger.setAttribute('aria-expanded', (!expanded).toString());
          dropdown?.setAttribute('aria-hidden', expanded ? 'true' : 'false');
          dropdown?.classList.toggle('open', !expanded);
        });
        const navClose = document.getElementById('nav-close');
        navClose?.addEventListener('click', () => {
          hamburger?.setAttribute('aria-expanded', 'false');
          dropdown?.setAttribute('aria-hidden', 'true');
          dropdown?.classList.remove('open');
        });
        // Nav background on scroll
        function navScrollBg() {
          if (window.scrollY > 10) mainNav?.classList.add('scrolled');
          else mainNav?.classList.remove('scrolled');
        }
        window.addEventListener('scroll', navScrollBg);
        navScrollBg();
        // Smooth scroll and active nav
        document.documentElement.style.scrollBehavior = 'smooth';
        const navLinks = document.querySelectorAll('.nav-dropdown a, .nav-contact');
        const sections = Array.from(document.querySelectorAll('.section'));
        function onScroll() {
          let scrollPos = window.scrollY + 120;
          let current = sections[0];
          for (const section of sections) {
            if ((section as HTMLElement).offsetTop <= scrollPos) current = section;
          }
          navLinks.forEach(link => {
            link.classList.toggle('active', link.getAttribute('href') === `#${current.id}`);
          });
        }
        window.addEventListener('scroll', onScroll);
        onScroll();
        // Custom cursor
        document.addEventListener('mousemove', e => {
          if (cursor) {
            cursor.style.left = e.clientX + 'px';
            cursor.style.top = e.clientY + 'px';
          }
        });
        const hoverables = document.querySelectorAll('a, button, .service-card, .project-card, .nav-hamburger, .nav-close');
        hoverables.forEach(el => {
          el.addEventListener('mouseenter', () => cursor?.classList.add('cursor-hover'));
          el.addEventListener('mouseleave', () => cursor?.classList.remove('cursor-hover'));
          el.addEventListener('focus', () => cursor?.classList.add('cursor-hover'));
          el.addEventListener('blur', () => cursor?.classList.remove('cursor-hover'));
        });
        // Gradient spot effect for hero section and top of about section
        const heroSection = document.querySelector('.hero-section') as HTMLElement | null;
        const aboutSection = document.querySelector('.about-section') as HTMLElement | null;
        const gradientSpotElement = document.querySelector('.hero-gradient-spot') as HTMLElement | null;
        function moveGradientSpot(e: MouseEvent, container: HTMLElement) {
          if (!gradientSpotElement) return;
          const rect = container.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          gradientSpotElement.style.left = `${x}px`;
          gradientSpotElement.style.top = `${y}px`;
          gradientSpotElement.style.opacity = '1';
        }
        if (heroSection && gradientSpotElement) {
          heroSection.addEventListener('mousemove', (e) => moveGradientSpot(e as MouseEvent, heroSection));
          heroSection.addEventListener('mouseleave', () => {
            if (gradientSpotElement) gradientSpotElement.style.opacity = '0';
          });
        }
        if (aboutSection && gradientSpotElement) {
          aboutSection.addEventListener('mousemove', (e) => {
            if (!gradientSpotElement) return;
            const rect = aboutSection.getBoundingClientRect();
            const y = (e as MouseEvent).clientY - rect.top;
            // Only show gradient in top 20% of about section
            if (y < rect.height * 0.2) {
              moveGradientSpot(e as MouseEvent, aboutSection);
            } else {
              gradientSpotElement.style.opacity = '0';
            }
          });
          aboutSection.addEventListener('mouseleave', () => {
            if (gradientSpotElement) gradientSpotElement.style.opacity = '0';
          });
        }
        // Custom progress scrollbar from about section downwards
        const progressBar = document.querySelector('.site-scrollbar-progress') as HTMLElement | null;
        const progressBarInner = document.querySelector('.site-scrollbar-progress-inner') as HTMLElement | null;
        // Use the already declared aboutSection for both gradient and progress bar logic
        const endSection = document.querySelector('footer') || document.body;
        let shimmerTimeout: number | undefined;
        function setShimmerActive(active: boolean) {
          if (!progressBar) return;
          if (active) {
            progressBar.classList.add('shimmer-active');
          } else {
            progressBar.classList.remove('shimmer-active');
          }
        }
        function updateProgressBar() {
          if (!progressBar || !progressBarInner || !aboutSection) return;
          const scrollY = window.scrollY;
          const aboutTop = aboutSection.offsetTop;
          const endBottom = document.body.scrollHeight;
          const windowHeight = window.innerHeight;
          const scrollStart = aboutTop;
          const scrollEnd = endBottom - windowHeight;
          if (scrollY < scrollStart) {
            progressBarInner.style.height = '0%';
            progressBar.style.opacity = '0';
          } else {
            progressBar.style.opacity = '1';
            const percent = Math.max(0, Math.min(100, ((scrollY - scrollStart) / (scrollEnd - scrollStart)) * 100));
            progressBarInner.style.height = percent + '%';
          }
        }
        function onScrollWithShimmer() {
          setShimmerActive(true);
          updateProgressBar();
          if (shimmerTimeout) window.clearTimeout(shimmerTimeout);
          shimmerTimeout = window.setTimeout(() => setShimmerActive(false), 200);
        }
        window.addEventListener('scroll', onScrollWithShimmer);
        window.addEventListener('resize', updateProgressBar);
        updateProgressBar();
        // Animated SVG handwriting effect for Wakeel Jones
        document.addEventListener('DOMContentLoaded', function() {
          const wjText = document.getElementById('wj-animated');
          if (wjText && wjText instanceof SVGTextElement) {
            const length = wjText.getComputedTextLength();
            wjText.setAttribute('stroke-dasharray', length.toString());
            wjText.setAttribute('stroke-dashoffset', length.toString());
            wjText.style.animation = 'wjDraw 2.5s cubic-bezier(.77,0,.18,1) forwards';
          }
        });
        // Project window scroll logic
        const projects = [
          {
            icon: '<i class="ri-apps-2-line"></i>',
            title: 'Portfolio OS',
            link: 'https://wakeeljones@netlify.app',
            image: '/assets/Portfolio.png',
            bg: 'linear-gradient(120deg, var(--accent), var(--accent-innovate), var(--bg-gradient))'
          },
          {
            icon: '<i class="ri-store-2-line"></i>',
            title: 'SideHustle ZA',
            link: 'https://sidehustleza.netlify.app',
            image: '/assets/SideHustleZA.png',
            bg: 'linear-gradient(120deg, var(--accent-innovate), var(--accent-lime), var(--bg-gradient))',
            comingSoon: true
          },
          {
            icon: '<i class="ri-chat-3-line"></i>',
            title: 'ChatPulse',
            link: 'https://aetherchat.netlify.app',
            image: '/assets/ChatPulse.png',
            bg: 'linear-gradient(120deg, var(--accent-teal), var(--accent), var(--bg-gradient))'
          }
        ];
        let projectIndex = 0;
        let isAnimating = false;
        function updateProjectWindow() {
          const titleEl = document.querySelector('#project-title');
          const linkEl = document.querySelector('#project-link');
          const iconEl = document.querySelector('.project-header i');
          const imageEl = document.getElementById('project-image');
          const titleBgEl = document.getElementById('project-title-bg');
          // Remove any existing banner
          let bannerEl = document.querySelector('.coming-soon-banner');
          if (bannerEl && bannerEl.parentNode) bannerEl.parentNode.removeChild(bannerEl);
          // Insert banner if comingSoon is true
          if (projects[projectIndex].comingSoon) {
            const banner = document.createElement('div');
            banner.className = 'coming-soon-banner';
            banner.textContent = 'Coming Soon';
            // Insert banner above the project link
            const slideContainer = document.getElementById('project-slide-container');
            if (slideContainer) {
              slideContainer.insertBefore(banner, slideContainer.querySelector('div[style*="display:flex"]'));
            }
          }
          if (titleEl) titleEl.textContent = projects[projectIndex].title;
          if (linkEl) {
            linkEl.setAttribute('href', projects[projectIndex].link);
            if (projects[projectIndex].comingSoon) {
              linkEl.classList.add('disabled');
              linkEl.setAttribute('tabindex', '-1');
              linkEl.setAttribute('aria-disabled', 'true');
              linkEl.style.pointerEvents = 'none';
              linkEl.style.opacity = '0.5';
              linkEl.textContent = 'View Project';
            } else {
              linkEl.classList.remove('disabled');
              linkEl.removeAttribute('tabindex');
              linkEl.removeAttribute('aria-disabled');
              linkEl.style.pointerEvents = '';
              linkEl.style.opacity = '';
              linkEl.textContent = 'View Project';
            }
          }
          if (iconEl) {
            const match = projects[projectIndex].icon.match(/ri-[^\s\"]+/);
            if (match) iconEl.className = match[0];
          }
          if (imageEl) imageEl.setAttribute('src', projects[projectIndex].image);
          if (titleBgEl) titleBgEl.textContent = projects[projectIndex].title;
          // Change background color of projects section
          const projectsSection = document.querySelector('.projects-section');
          if (projectsSection && projectsSection instanceof HTMLElement) {
            projectsSection.style.transition = 'background 0.7s cubic-bezier(.77,0,.18,1)';
            projectsSection.style.background = projects[projectIndex].bg;
          }
        }
        // Mouse wheel scroll for project navigation with vertical slide animation
        const projectWindow = document.getElementById('project-window');
        const projectSlideContainer = document.getElementById('project-slide-container');
        if (projectWindow && projectSlideContainer) {
          projectWindow.addEventListener('wheel', (e) => {
            if (isAnimating) return;
            // Scroll forward (down) - next project
            if ((e.deltaY > 0 || e.deltaX > 0) && projectIndex < projects.length - 1) {
              e.preventDefault();
              isAnimating = true;
              projectSlideContainer.classList.remove('slide-reset', 'slide-down');
              projectSlideContainer.classList.add('slide-up');
              setTimeout(() => {
                projectIndex = (projectIndex + 1);
                updateProjectWindow();
                projectSlideContainer.classList.remove('slide-up');
                projectSlideContainer.classList.add('slide-down');
                setTimeout(() => {
                  projectSlideContainer.classList.remove('slide-down');
                  projectSlideContainer.classList.add('slide-reset');
                  isAnimating = false;
                }, 600);
              }, 600);
            }
            // Scroll backward (up) - previous project
            else if ((e.deltaY < 0 || e.deltaX < 0)) {
              if (projectIndex > 0) {
                e.preventDefault();
                isAnimating = true;
                projectSlideContainer.classList.remove('slide-reset', 'slide-up');
                projectSlideContainer.classList.add('slide-down');
                setTimeout(() => {
                  projectIndex = (projectIndex - 1);
                  updateProjectWindow();
                  projectSlideContainer.classList.remove('slide-down');
                  projectSlideContainer.classList.add('slide-up');
                  setTimeout(() => {
                    projectSlideContainer.classList.remove('slide-up');
                    projectSlideContainer.classList.add('slide-reset');
                    isAnimating = false;
                  }, 600);
                }, 600);
              }
              // If already at first project, do not preventDefault so the page scrolls up
            }
          }, { passive: false });
          // Set initial state
          projectSlideContainer.classList.add('slide-reset');
        }
        updateProjectWindow();
      }
    </script>
    <!-- Back to Top Button -->
    <button id="back-to-top" aria-label="Back to top" style="display:flex;"><i class="ri-arrow-up-line"></i></button>
    <script>
      // Back to Top Button Logic
      const backToTopBtn = document.getElementById('back-to-top');
      if (backToTopBtn) {
        let isScrollingToTop = false;
        window.addEventListener('scroll', () => {
          if (window.scrollY > window.innerHeight * 0.5) {
            backToTopBtn.style.display = 'flex';
            backToTopBtn.style.opacity = '0.92';
          } else if (!isScrollingToTop) {
            backToTopBtn.style.opacity = '0';
            setTimeout(() => { backToTopBtn.style.display = 'none'; }, 200);
          }
          if (window.scrollY === 0) isScrollingToTop = false;
        });
        backToTopBtn.addEventListener('click', () => {
          isScrollingToTop = true;
          window.scrollTo({ top: 0, behavior: 'smooth' });
          setTimeout(() => {
            // Fallback: if still not at top, jump instantly
            if (window.scrollY !== 0) {
              window.scrollTo(0, 0);
              console.log('Fallback: Instantly scrolled to top');
            }
            isScrollingToTop = false;
          }, 1200);
        });
      }
    </script>
    <!-- Custom Scrollbar Progress Bar Script -->
    <script>
      function updateCustomScrollbar() {
        const progress = document.querySelector('.site-scrollbar-progress-inner');
        if (!progress) return;
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const percent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        if (progress instanceof HTMLElement) progress.style.height = percent + '%';
      }
      window.addEventListener('scroll', updateCustomScrollbar);
      window.addEventListener('resize', updateCustomScrollbar);
      document.addEventListener('DOMContentLoaded', updateCustomScrollbar);
    </script>
