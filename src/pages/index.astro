    <link rel="stylesheet" href="/splash.css" />
    <style>
      @keyframes wjDraw {
        to { stroke-dashoffset: 0; }
      }
      .scroll-animate {
        display: inline-block;
        background: linear-gradient(90deg, #7f53ac, #647dee, #00bfae, #c6ff00);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: scrollTextAnim 2.5s linear infinite alternate;
      }
      @keyframes scrollTextAnim {
        0% { background-position: 0% 50%; }
        100% { background-position: 100% 50%; }
      }
      .site-scrollbar-progress {
        position: fixed;
        right: 0;
        top: 0;
        width: 6px;
        height: 100vh;
        background: rgba(127,83,172,0.08);
        z-index: 9999;
        border-radius: 3px;
      }
      .site-scrollbar-progress-inner {
        width: 100%;
        background: linear-gradient(180deg,#7f53ac,#647dee,#00bfae,#c6ff00);
        border-radius: 3px;
        transition: height 0.2s cubic-bezier(.77,0,.18,1);
      }
      html, body {
        height: 100%;
        overflow-x: hidden;
      }
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .main-footer {
        margin-top: auto;
      }
      @media (max-width: 700px) {
        .section,
        .contact-section,
        .contact-content,
        .main-footer,
        .quote-banner,
        .projects-section {
          width: 100vw !important;
          max-width: 100vw !important;
          margin-left: 0 !important;
          margin-right: 0 !important;
          padding-left: 0.5rem !important;
          padding-right: 0.5rem !important;
          box-sizing: border-box;
        }
        .contact-form {
          width: 100vw !important;
          max-width: 100vw !important;
          margin-left: 0 !important;
          margin-right: 0 !important;
          grid-template-columns: 1fr !important;
          grid-template-rows: auto auto auto !important;
        }
        .contact-form > div,
        .contact-form textarea,
        .contact-form input {
          width: 100% !important;
          margin-right: 0 !important;
        }
        .project-window img,
        .project-image {
          width: 100vw !important;
          max-width: 100vw !important;
          left: 0 !important;
        }
        .scroll-instruction,
        .social-media-row {
          width: 100vw !important;
          max-width: 100vw !important;
          margin-left: 0 !important;
          margin-right: 0 !important;
        }
        .site-scrollbar-progress {
          display: none;
        }
      }
      /* Project slide animation styles */
      .project-slide-container {
        transition: transform 0.6s cubic-bezier(.77,0,.18,1), opacity 0.6s cubic-bezier(.77,0,.18,1);
        will-change: transform, opacity;
      }
      .slide-up {
        transform: translateY(-100%);
        opacity: 0;
      }
      .slide-down {
        transform: translateY(100%);
        opacity: 0;
      }
      .slide-reset {
        transform: translateY(0);
        opacity: 1;
      }
    </style>
  </head>
  <body>
    <!-- Browser check: Only allow Chrome -->
    <script>
      if (typeof window !== 'undefined') {
        var isChrome = /Chrome\//.test(navigator.userAgent) && /Google Inc/.test(navigator.vendor);
        if (!isChrome) {
          var overlay = document.createElement('div');
          overlay.style.position = 'fixed';
          overlay.style.top = '0';
          overlay.style.left = '0';
          overlay.style.width = '100vw';
          overlay.style.height = '100vh';
          overlay.style.background = 'rgba(20,20,30,0.98)';
